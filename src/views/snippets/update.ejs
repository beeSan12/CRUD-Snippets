<h1>Update snippet</h1>
<form class="row g-3" method="post" action="./snippets/<%= viewData?.id %>/update">
  <div class="col-md-12">
    <label class="form-label" for="descriptionInput">
      Description
    </label>
    <input type="text" class="form-control" id="descriptionInput" name="description" placeholder="Update snippet description here" value="<%= viewData?.description %>" required autofocus />
  </div>
  <div class="col-12">
    <div class="form-check">
      <input type="checkbox" class="form-check-input" id="privateCheck" name="private" />
      <label class="form-check-label" for="privateCheck">
        Private
      </label>
    </div>
  </div>
  <div class="col-12">
    <div class="form-check">
      <input type="checkbox" class="form-check-input" id="justForMeCheck" name="justForMe" />
      <label class="form-check-label" for="justForMeCheck">
        Just for me
      </label>
    </div>
  </div>
  <div class="col-12">
    <button type="submit" class="btn btn-primary">Update</button>
  </div>
  <br>
</form>
